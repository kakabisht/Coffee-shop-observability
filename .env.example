POSTGRES_USER=coffee
POSTGRES_PASSWORD=coffee-local-only
POSTGRES_DB=coffee_shop

# For local development only. Change these values before exposing any service.
OPENSEARCH_JAVA_OPTS=-Xms768m -Xmx768m

# Enable controlled latency/resource scenarios only for local learning environments.
ENABLE_DEMO_SCENARIOS=true

# Optional: send the same OTLP traces, metrics, and logs to Dash0.
# Use with: docker compose -f docker-compose.yml -f docker-compose.dash0.yml up --build -d
# DASH0_OTLP_GRPC_ENDPOINT=ingress.example.dash0.com:4317
# DASH0_AUTH_TOKEN=auth_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# DASH0_DATASET=default
